[Unit]
Description=ohmyclawd daemon — reports Claude Code utilization and sessions
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ohmyclawd-daemon
Restart=always
RestartSec=5
User=__USER__
Group=__USER__
# Bind address. Options:
#   127.0.0.1:8787  — localhost only (default, safest)
#   :8787           — all interfaces (LAN access)
Environment=OHMYCLAWD_LISTEN=127.0.0.1:8787

# Usage sources, tried in order:
#   cli   — `claude -p /usage` (no tokens used), every OHMYCLAWD_CLI_INTERVAL
#   probe — 1-token Haiku request, read rate-limit headers, every OHMYCLAWD_PROBE_INTERVAL
# Set to "probe" for the original behavior.
Environment=OHMYCLAWD_SOURCES=cli,probe
Environment=OHMYCLAWD_PROBE_INTERVAL=60s
# Environment=OHMYCLAWD_CLI_INTERVAL=3m

# Stop fetching after no /usage requests for this long (0 = never idle).
# Environment=OHMYCLAWD_IDLE_AFTER=5m

# Session counting: auto (herdr, else tmux) | herdr | tmux | off
# Environment=OHMYCLAWD_SESSIONS=auto
# Environment=OHMYCLAWD_HERDR_WAITING=blocked

# systemd's default PATH omits ~/.local/bin, where claude usually lives.
Environment=PATH=__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin

# OHMYCLAWD_CREDS_PATH defaults to ~/.claude/.credentials.json under the target user.

# Optional bearer token, read from $STATE_DIRECTORY/token (mode 0600).
# If the file exists, /usage and /metrics require:
#   Authorization: Bearer <token>
# Create or show it with:  sudo -u __USER__ ohmyclawd-daemon token
# Delete the file for open access (LAN-only setups).
StateDirectory=ohmyclawd
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=read-only
# The CLI refreshes OAuth credentials and caches state under ~/.claude. It
# also tries to save ~/.claude.json via a temp file in $HOME; that fails
# harmlessly here and /usage still works. "-" tolerates a missing path.
ReadWritePaths=__HOME__/.claude -__HOME__/.claude.json

[Install]
WantedBy=multi-user.target
